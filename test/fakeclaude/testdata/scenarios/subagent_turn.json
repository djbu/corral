{
  "name": "subagent_turn",
  "steps": [
    {"op": "fire_hook", "event": "SessionStart", "payload": {"source": "startup"}},
    {"op": "emit_tui", "text": "> ready"},
    {"op": "wait_stdin", "match": "^.+\r?\n$", "capture": "prompt", "timeout": "10s"},
    {"op": "fire_hook", "event": "UserPromptSubmit", "payload": {"prompt_id": "p1", "prompt": "{{prompt}}"}},
    {"op": "fire_hook", "event": "SubagentStart", "payload": {"prompt_id": "p1", "agent_id": "agent_01", "agent_type": "Explore"}},
    {"op": "fire_hook", "event": "PreToolUse", "payload": {"prompt_id": "p1", "agent_id": "agent_01", "tool_name": "Grep", "tool_use_id": "toolu_sub_01", "tool_input": {"pattern": "foo"}}},
    {"op": "fire_hook", "event": "PostToolUse", "payload": {"prompt_id": "p1", "agent_id": "agent_01", "tool_name": "Grep", "tool_use_id": "toolu_sub_01", "tool_response": {"matches": 0}}},
    {"op": "fire_hook", "event": "SubagentStop", "payload": {"prompt_id": "p1", "agent_id": "agent_01", "agent_type": "Explore"}},
    {"op": "fire_hook", "event": "Stop", "payload": {"prompt_id": "p1", "stop_hook_active": false}},
    {"op": "wait_stdin", "match": "^__never_sent__$", "optional": true, "timeout": "60s"},
    {"op": "exit", "code": 0}
  ]
}
